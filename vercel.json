{
  "version": 2,
  "builds": [
    {
      "src": "/",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "status": 200,
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/(.*)",
      "status": 200
    }
  ],
  "cleanOutputs": true
}
